[submodule "SmartContracts/lib/openzeppelin-contracts"]
	path = SmartContracts/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts.git
[submodule "SmartContracts/lib/openzeppelin-contracts-upgradeable"]
	path = SmartContracts/lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable.git
[submodule "SmartContracts/lib/forge-std"]
	path = SmartContracts/lib/forge-std
	url = https://github.com/foundry-rs/forge-std.git
[submodule "SmartContracts/lib/erc-8183-base-contracts"]
	path = SmartContracts/lib/erc-8183-base-contracts
	url = https://github.com/erc-8183/base-contracts.git
